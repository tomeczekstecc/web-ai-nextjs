PORT=3600
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=CI-PRS
NEXT_PUBLIC_SITE_URL=http://localhost:3600
NEXT_PUBLIC_API_URL=http://localhost:3600/api

# sidebar | top-menu
NEXT_PUBLIC_NAV_LAYOUT=sidebar

# top-left | top-center | top-right | bottom-left | bottom-center | bottom-right
NEXT_PUBLIC_TOAST_POSITION=bottom-right

API_URL=http://127.0.0.1:8000
BETTER_AUTH_SECRET=local-dev-secret-change-me-in-production
BETTER_AUTH_URL=http://localhost:3600
DATABASE_URL=file:./dev.db
LARAVEL_INTERNAL_AUTH_TOKEN=safe-token
LARAVEL_INTERNAL_AUTH_MAIL_TOKEN=safe-token
LARAVEL_INTERNAL_AUTH_REVOKE_TOKEN=safe-token

# true | false
AUTH_SIGNUP_ENABLED=true

# true | false — requires AUTH_SSO_* env vars below (any OIDC provider, e.g. Keycloak, Authentik, Auth0)
AUTH_SSO_ENABLED=false

# true | false — requires OAuth providers configured in better-auth (Apple, Google, Meta)
AUTH_SOCIAL_LOGIN_ENABLED=false

# true | false
AUTH_LARAVEL_MOCK_ENABLED=true

# true | false
AUTH_SESSION_BYPASS_ENABLED=true

AUTH_MOCK_ROLE=Admin # User / Admin / Oper

AUTH_SUPPORT_LABEL=
AUTH_SUPPORT_URL=

# Generic OIDC SSO provider (e.g. Keycloak, Authentik, Auth0).
# AUTH_SSO_ISSUER must be the issuer URL exposing /.well-known/openid-configuration.
AUTH_SSO_CLIENT_ID=
AUTH_SSO_CLIENT_SECRET=
AUTH_SSO_ISSUER=

# Set to 1 to skip env validation (e.g. CI lint stages without secrets)
# SKIP_ENV_VALIDATION=1
