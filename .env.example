PORT=3600
NEXT_PUBLIC_APP_NAME=CI-PRS
NEXT_PUBLIC_SITE_URL=http://localhost:3600
NEXT_PUBLIC_API_URL=http://localhost:3600/api

# sidebar | top-menu
NEXT_PUBLIC_NAV_LAYOUT=sidebar

# top-left | top-center | top-right | bottom-left | bottom-center | bottom-right
NEXT_PUBLIC_TOAST_POSITION=bottom-right

API_URL=http://127.0.0.1:8000
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3600
DATABASE_URL=
LARAVEL_INTERNAL_AUTH_TOKEN=
LARAVEL_INTERNAL_AUTH_MAIL_TOKEN=
LARAVEL_INTERNAL_AUTH_REVOKE_TOKEN=

# true | false
AUTH_SIGNUP_ENABLED=true

# true | false — requires Keycloak env vars below
AUTH_SSO_ENABLED=false

# true | false — requires OAuth providers configured in better-auth (Apple, Google, Meta)
AUTH_SOCIAL_LOGIN_ENABLED=false

# true | false
AUTH_LARAVEL_MOCK_ENABLED=false

# true | false
AUTH_SESSION_BYPASS_ENABLED=false

AUTH_SUPPORT_LABEL=
AUTH_SUPPORT_URL=

KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ISSUER=
